<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>500 - Internal Server Error</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <style>
    body {
      background-color: #fff3cd;
      padding: 60px;
      text-align: center;
    }
    h1 {
      font-size: 100px;
      color: #dc3545;
    }
    h2 {
      color: #856404;
    }
    pre {
      background-color: #f8d7da;
      padding: 15px;
      text-align: left;
      max-width: 700px;
      margin: 20px auto;
      overflow-x: auto;
    }
  </style>
</head>
<body>

  <h1>500</h1>
  <h2><%= message %></h2>
  <p>Something went wrong on the server.</p>

  <% if (error) { %>
    <pre><%= error.stack %></pre>
  <% } %>

  <% if (role === 'admin') { %>
    <a href="/admin/dashboard" class="btn btn-danger mt-4">Back to Dashboard</a>
  <% } else { %>
    <a href="/" class="btn btn-secondary mt-4">Go Home</a>
  <% } %>

</body>
</html>
