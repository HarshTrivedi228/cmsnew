<div id="admin-content">
  <div class="container">
    <div class="row align-items-center mb-3">
      <div class="col-md-10 col-8">
        <h1 class="admin-heading">
          <i class="fa fa-users"></i> All Users
        </h1>
      </div>
      <div class="col-md-2 col-4 text-end">
        <a class="add-new btn btn-sm btn-primary" href="/admin/add-user">Add User</a>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <div class="table-responsive">
          <table class="content-table table table-bordered table-striped bg-white">
            <thead class="table-dark">
              <tr>
                <th>S.No.</th>
                <th>Full Name</th>
                <th>User Name</th>
                <th>Role</th>
                <th>Edit</th>
                <th>Delete</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach((user, index) => { %>
                <tr>
                  <td class='id'><%= index + 1 %></td>
                  <td><%= user.fullname %></td>
                  <td><%= user.username %></td>
                  <td><%= user.role %></td>
                  <td class='edit'>
                    <a href="/admin/update-user/<%= user._id %>">
                      <i class='fa fa-edit'></i>
                    </a>
                  </td>
                  <td class='delete'>
                    <a href="/admin/delete-user/<%= user._id %>" onclick="return confirm('Are you sure you want to delete this user?');">
                      <i class='fa fa-trash-o'></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <nav class="mt-3">
          <ul class="pagination justify-content-center">
            <li class="page-item disabled">
              <a class="page-link">Previous</a>
            </li>
            <li class="page-item"><a class="page-link" href="#">1</a></li>
            <li class="page-item active">
              <a class="page-link" href="#" aria-current="page">2</a>
            </li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item">
              <a class="page-link" href="#">Next</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</div>
<style>
  .admin-heading {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 10px;
  }

  .add-new {
    text-decoration: none;
    font-size: 14px;
    padding: 6px 12px;
  }

  .content-table {
    width: 100%;
    margin-top: 15px;
  }

  @media (max-width: 768px) {
    .admin-heading {
      font-size: 18px;
    }

    .add-new {
      font-size: 12px;
      padding: 5px 10px;
    }

    .table-responsive {
      overflow-x: auto;
    }

    .pagination {
      flex-wrap: wrap;
    }
  }
</style>
