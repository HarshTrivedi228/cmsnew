<div id="admin-content">
  <div class="container">
    <div class="row justify-content-center mt-5">
      <div class="col-md-6">
        <div class="card shadow-lg border-danger">
          <div class="card-body text-center">
            <div class="display-4 text-danger mb-3">❌</div>
            <h3 class="text-dark">Oops! Cannot Delete User</h3>
            <p class="text-muted mt-3 mb-4">
              <%= message || "Sorry! You cannot delete this user. Articles are linked with their account." %>
            </p>
            <a href="/admin/users" class="btn btn-danger">
              ⬅️ Go Back
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
