<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Update Article</title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Summernote CSS -->
  <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-bs5.min.css" rel="stylesheet">
</head>
<body>

  <div id="admin-content">
    <div class="container py-4">
      <div class="row">
        <div class="col-md-12">
          <h1 class="admin-heading">Update Article</h1>
        </div>
        <div class="col-md-8 mx-auto">
          <div class="card shadow">
            <h5 class="card-header">Update Article</h5>
            <div class="card-body">

              <!-- Form Start -->
              <form action="/admin/update-article/<%= article._id %>" method="POST" enctype="multipart/form-data">
                
                <!-- Title -->
                <div class="mb-3">
                  <label for="article_title" class="form-label">Title</label>
                  <input type="text" name="title" id="article_title" class="form-control" value="<%= article.title %>" required>
                </div>

                <!-- Description -->
                <div class="mb-3">
                  <label for="summernote" class="form-label">Description</label>
                  <textarea name="content" id="summernote" class="form-control" rows="5" required><%= article.content %></textarea>
                </div>

                <!-- Category -->
                <div class="mb-3">
                  <label for="article_category" class="form-label">Category</label>
                  <select name="category" id="article_category" class="form-control" required>
                    <% categories.forEach(function(category) { %>
                      <option value="<%= category._id %>" 
                        <%= category._id.toString() === article.category._id.toString() ? 'selected' : '' %>>
                        <%= category.name %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <!-- Image -->
                <div class="mb-3">
                  <label for="article_image" class="form-label">Article Image</label>
                  <input type="file" name="image" id="article_image" class="form-control">
                  <% if (article.image) { %>
                    <img src="/uploads/<%= article.image %>" alt="Current Image" width="80" class="mt-2 rounded shadow-sm">
                  <% } %>
                </div>

                <!-- Submit -->
                <input type="submit" class="btn btn-primary" value="Update">
              </form>
              <!-- Form End -->

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-bs5.min.js"></script>

  <!-- Summernote Init -->
  <script>
    $(document).ready(function () {
      $('#summernote').summernote({
        placeholder: 'Write article content here...',
        height: 250,
        toolbar: [
          ['style', ['style']],
          ['font', ['bold', 'italic', 'underline', 'clear']],
          ['fontname', ['fontname']],
          ['fontsize', ['fontsize']],
          ['color', ['color']],
          ['para', ['ul', 'ol', 'paragraph']],
          ['insert', ['link', 'picture', 'video']],
          ['view', ['fullscreen', 'codeview', 'help']]
        ]
      });
    });
  </script>

</body>
</html>
