<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>
    <% if (settings && settings.website_title && settings.website_title.trim() !== '') { %>
      <%= settings.website_title %>
    <% } else { %>
      News Portal
    <% } %>
  </title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome Icon -->
  <link rel="stylesheet" href="/css/font-awesome.css">
  <!-- Custom stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Logo Image Style */
    #footer {
  background-color: #007BFF; /* Bootstrap Blue */
  color: white;
}

#footer a {
  color: #FFD700; /* Golden link color */
  text-decoration: underline;
}

#footer a:hover {
  color: white;
}

    #logo img {
      max-height: 130px;
      width: 200px;
      border-radius: 50%;
      display: block;
      margin: 0 auto;
      margin-top: -40px;
      margin-bottom: -22px;
    }
  
.menu li a:hover {
  background-color: rgb(8, 7, 7);
}
   
  </style>
</head>
<body>
<!-- HEADER -->
<div id="header">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-3">
        <% if (settings && settings.website_logo && settings.website_logo.trim() !== '') { %>
          <a href="/" id="logo">
            <img src="/uploads/<%= settings.website_logo %>" alt="Logo" />
          </a>
        <% } else { %>
          <a href="/" id="logo">
            <img src="/images/news.jpg" alt="Logo" />
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>
<!-- /HEADER -->

<!-- Menu Bar -->
<div id="menu-bar">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <ul class='menu'>
          <li><a href='/'>Home</a></li>
          <% (categories || []).forEach(function(category) { %>
            <li><a href="/category/<%= category.slug %>"><%= category.name %></a></li>
          <% }) %>
           <li class="float-end"><a href='/admin'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#555" viewBox="0 0 24 24">
  <circle cx="12" cy="12" r="10" stroke="#ccc" stroke-width="1.5" fill="#f5f5f5" />
  <circle cx="12" cy="8.5" r="3" fill="#555" />
  <path d="M7,18 C7,14.5 17,14.5 17,18" fill="#555" />
</svg>
</a></li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Main Content -->
<div id="main-content">
  <div class="container-fluid px-3 mx-0">
    <div class="row g-4">
    
      <!-- Body Section -->
      <div class="col-lg-8 col-md-12">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-3">
            <%- body %>
          </div>
        </div>
      </div>

      <!-- Sidebar Section -->
      <div class="col-lg-3 col-md-12">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-3">
            <%- include('partials/sidebar', { latestNews: latestNews }) %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
<!-- /Main Content -->

<!-- FOOTER -->
<div id="footer" class="py-4">
  <div class="container">
    <div class="row">
      <div class="col-md-12 text-center">
        <p>
          <% if (settings && settings.footer_description && settings.footer_description.trim() !== '') { %>
            <%= settings.footer_description %>
          <% } else { %>
            © Copyright 2025 News | Powered by 
            <a href="http://www.yahubaba.com/">Yahu Baba</a>
          <% } %>
        </p>
      </div>
    </div>
  </div>
</div>
<!-- /FOOTER -->

<!-- Bootstrap JS -->
<script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
