<!-- =================== Start Cards Section =================== -->
<style>
  body {
    background-color: rgb(255, 255, 255);
  }

  .card {
    border: none;
    border-radius: 3px;
    overflow: hidden;
    background-color: #ffffff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  .card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .card-title a {
    font-size: 1.25rem;
    font-weight: bold;
    color: #1E90FF;
  }

  .card-text small i {
    margin-right: 5px;
  }

  .card-body {
    padding: 1rem 1.5rem;
  }

  .btn-outline-primary {
    border-radius: 20px;
    font-weight: 500;
  }

  .pagination .page-link {
    border-radius: 10px;
    margin: 0 5px;
  }
</style>

<div class="row">
  <% const news = paginatedNews.data; %>
  <% news.forEach(item => { %>
    <div class="col-lg-12 mb-4">
      <div class="card">
        <div class="row g-0">
          <div class="col-md-4">
            <a href="/single/<%= item._id %>">
              <img src="/uploads/<%= item.image || 'default.jpg' %>" class="img-fluid" alt="<%= item.title %>">
            </a>
          </div>
          <div class="col-md-8">
            <div class="card-body">
              <h5 class="card-title">
                <a href="/single/<%= item._id %>" class="text-decoration-none">
                  <%= item.title %>
                </a>
              </h5>
              <p class="card-text">
                <small class="text-muted me-3">
                  <i class="fa fa-tags"></i>
                  <a href="/category/<%= item.category.slug %>" class="text-muted text-decoration-none">
                    <%= item.category.name %>
                  </a>
                </small>
                <small class="text-muted me-3">
                  <i class="fa fa-user"></i>
                  <a href="/author/<%= item.author._id %>" class="text-muted text-decoration-none">
                    <%= item.author.fullname %>
                  </a>
                </small>
                <small class="text-muted">
                  <i class="fa fa-calendar"></i>
                  <%= new Date(item.createdAt).toDateString() %>
                </small>
              </p>

              <% const plainText = item.content.replace(/<[^>]*>/g, '') %>
              <div class="card-text text-muted fw-bold">
                <%= plainText.substring(0, 140) %>...
              </div>

              <div class="d-flex justify-content-end mt-3 gap-2">
                <a href="/single/<%= item._id %>" class="btn btn-sm btn-outline-primary">Read more</a>
                <button class="btn btn-sm btn-outline-success"
                  onclick="shareThis('<%= item.title.replace(/'/g, '\\\'') %>', '<%= item._id %>')">
                  🔗 Share
                </button>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<!-- SHARE SCRIPT -->
<script>
  function shareThis(title, id) {
    const url = `${window.location.origin}/single/${id}`;

    if (navigator.share) {
      navigator.share({
        title: title,
        text: "Check out this article",
        url: url
      }).catch(err => console.error("Sharing failed:", err));
    } else {
      navigator.clipboard.writeText(url).then(() => {
        alert("🔗 Link copied to clipboard!");
      }).catch(err => {
        alert("❌ Failed to copy link.");
        console.error(err);
      });
    }
  }
</script>

<%
// Helper to build query string with pagination
const buildquery = (query, page) => {
  const params = new URLSearchParams();
  for (const key in query) {
    if (key !== 'page') {
      params.set(key, query[key]);
    }
  }
  params.set('page', page);
  return '?' + params.toString();
};
%>

<nav aria-label="Page navigation example">
  <ul class="pagination justify-content-center mt-4">
    <% if (paginatedNews.currentPage > 1) { %>
      <li class="page-item">
        <a class="page-link" href="<%= buildquery(query, paginatedNews.currentPage - 1) %>">Previous</a>
      </li>
    <% } else { %>
      <li class="page-item disabled"><span class="page-link">Previous</span></li>
    <% } %>

    <% for (let i = 1; i <= paginatedNews.totalPages; i++) { %>
      <li class="page-item <%= i === paginatedNews.currentPage ? 'active' : '' %>">
        <a class="page-link" href="<%= buildquery(query, i) %>"><%= i %></a>
      </li>
    <% } %>

    <% if (paginatedNews.currentPage < paginatedNews.totalPages) { %>
      <li class="page-item">
        <a class="page-link" href="<%= buildquery(query, paginatedNews.currentPage + 1) %>">Next</a>
      </li>
    <% } else { %>
      <li class="page-item disabled"><span class="page-link">Next</span></li>
    <% } %>
  </ul>
</nav>
